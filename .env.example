# ════════════════════════════════════════════════════════════════
# GRUDGE STUDIO — GrudaChain Server Environment Variables
# Copy to .env and fill in values for local development
# ════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-in-production

# ── Grudge Studio Ecosystem URLs ───────────────────────────────
AUTH_GATEWAY_URL=https://id.grudge-studio.com
GAME_API_URL=https://api.grudge-studio.com

# ── Databases (optional — server degrades gracefully without) ──
# DATABASE_URL=postgresql://user:pass@host:5432/grudge
# REDIS_URL=redis://host:6379

# ── AI Providers (optional — all free-tier, leave blank to skip) ─
# MEGALLM_API_KEY=
# OPENROUTER_API_KEY=
# AGENTROUTER_API_KEY=
# ROUTEWAY_API_KEY=
# OPEN_AI_API=

# ── Expansion Services ─────────────────────────────────────────────────────
# GRUDGE_PLATFORM_URL=https://grudge-platform.vercel.app
# GDEVELOP_URL=https://gdevelop-assistant.vercel.app
# GRUDA_LEGION_URL=https://api.grudge-studio.com

# ── Colyseus Multiplayer (grudge-server) ───────────────────────────
COLYSEUS_SERVER_URL=

# ── Frontend Env (VITE_* vars for client-side apps) ────────────
# VITE_AUTH_URL=https://id.grudge-studio.com
# VITE_API_URL=https://api.grudge-studio.com
# VITE_ACCOUNT_URL=https://account.grudge-studio.com
# VITE_WS_URL=wss://ws.grudge-studio.com
# VITE_OBJECTSTORE_URL=https://molochdagod.github.io/ObjectStore/api/v1

# ════════════════════════════════════════════════════════════════
# DO NOT ADD:
# - SUPABASE_URL / SUPABASE_KEY (removed — not used)
# - NEON_DATABASE_URL (removed — VPS DB only)
# ════════════════════════════════════════════════════════════════
