# GrudaChain Nexus - Environment Variables
# Copy to .env and fill in values

# ── Auth Gateway ──
AUTH_GATEWAY_URL=https://auth-gateway-flax.vercel.app

# ── AI Provider Keys (Vibe 8.0.0) ──
MEGALLM_API_KEY=
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=
ROUTEWAY_API_KEY=

# ── Supabase (optional - for persistent storage) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Server (local dev only, not used on Vercel) ──
PORT=3000
NODE_ENV=development
SESSION_SECRET=
