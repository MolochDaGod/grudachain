{
  "version": 2,
  "installCommand": "npm install",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "grudachain-rho.vercel.app" }],
      "destination": "https://nexus.grudge-studio.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "grudachain.vercel.app" }],
      "destination": "https://nexus.grudge-studio.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.png" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*|grudge-logo.*|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
